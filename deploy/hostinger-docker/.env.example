POLY_PRIVATE_KEY=replace_me
POLY_FUNDER=replace_me
POLY_SIGNATURE_TYPE=1
POLY_DRY_RUN=true

RELAYER_API_KEY=
RELAYER_SECRET=
RELAYER_PASSPHRASE=

BOT_LOG_LEVEL=INFO
BOT_POLL_INTERVAL_SECONDS=1.0
BOT_REQUEST_TIMEOUT_SECONDS=10.0

# PALADIN v7 live (default for this stack). Use paladin for pair ladder only.
BOT_STRATEGY_MODE=paladin_v7
# Forced hedge: after timeout, allow when mid_up+mid_dn <= this (default 1.30; config clamps to max 1.50).
BOT_PALADIN_V7_FORCED_HEDGE_SUM_MAX=1.30
# Pair mid sum: wait until pm_up+pm_down <= this before first leg and before non-forced second leg
BOT_PALADIN_PAIR_SUM_MAX=0.97
# After hedge-force timer: allow second leg if mid sum <= this (1.0 = complete hedge; set 0.97 to stay strict)
BOT_PALADIN_PAIR_SUM_MAX_ON_FORCE=1.0
BOT_PALADIN_MAX_SHARES_PER_SIDE=10
BOT_PALADIN_MIN_ELAPSED_BETWEEN_PAIR_STARTS=100
# -1 = no trailing dip filter (v4 default)
BOT_PALADIN_ENTRY_TRAILING_MIN_LOW_SEC=-1
BOT_PALADIN_TARGET_MIN_ROI=0
BOT_PALADIN_STAGGER_ALTERNATE_FIRST_WHEN_BALANCED=true
# Seconds after hedge-ready before forcing second leg (A/B variant E = 90)
BOT_PALADIN_STAGGER_HEDGE_FORCE_SEC=90
# Post-fill avg_up+avg_down must stay <= this (97c pair discipline)
BOT_PALADIN_MAX_BLENDED_PAIR_AVG_SUM=0.97
# false = symmetric fallback first leg also obeys blended cap
BOT_PALADIN_STAGGER_SYMMETRIC_FALLBACK_SKIP_FIRST_BLEND=false
BOT_SHARES_PER_LEVEL=6
BOT_STRATEGY_BUDGET_CAP_USDC=80.0
BOT_STRATEGY_WALLET_RESERVE_USDC=0.0
BOT_STRATEGY_MIN_BUDGET_USDC=15.0
# 0 = start PALADIN clips at window elapsed 0 (no warmup wait)
BOT_STRATEGY_ENTRY_DELAY_SECONDS=0
BOT_STRATEGY_NEW_ORDER_CUTOFF_SECONDS=30
BOT_FORCE_EXIT_BEFORE_END_SECONDS=15
