POLY_PRIVATE_KEY=replace_me
POLY_FUNDER=replace_me
POLY_SIGNATURE_TYPE=1
POLY_DRY_RUN=true

RELAYER_API_KEY=
RELAYER_SECRET=
RELAYER_PASSPHRASE=

BOT_LOG_LEVEL=INFO
BOT_POLL_INTERVAL_SECONDS=1.0
BOT_REQUEST_TIMEOUT_SECONDS=10.0

# --- PALADIN v7 (Binance spike + BTC jump → PM; default for this deploy) ---
BOT_STRATEGY_MODE=paladin_v7
BOT_POLY_WS_ENABLED=true
BOT_POLY_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market

# Forced hedge: after hedge_timeout, allow when mid_up + mid_dn <= this (default 1.30; config max 1.50).
BOT_PALADIN_V7_FORCED_HEDGE_SUM_MAX=1.30
# Our pair economics: cheap hedge (held VWAP + opposite + slip) & refill (projected avg_up+avg_down). Not pm_u+pm_d.
BOT_PALADIN_V7_CHEAP_PAIR_AVG_SUM_NONFORCED_MAX=0.96
BOT_PALADIN_V7_CHEAP_HEDGE_SLIP_BUFFER=0.012
BOT_PALADIN_V7_CHEAP_HEDGE_MIN_DELAY_SEC=0
BOT_PALADIN_V7_HEDGE_TIMEOUT_SEC=90
BOT_PALADIN_V7_PAIR_COOLDOWN_SEC=20
BOT_PALADIN_V7_CLIP_SHARES=5
BOT_PALADIN_V7_MAX_SHARES_PER_SIDE=10
BOT_PALADIN_V7_MAX_ORDERS=4
BOT_PALADIN_V7_FIRST_LEG_MAX_PM=0.62
BOT_PALADIN_V7_REFILL_PAIR_SUM_MAX=0.985
# Refill book screen only (pm_u+pm_d); nonforced cap applies to projected leg VWAPs in strategy code.
BOT_BTC_FEED_ENABLED=true

BOT_STRATEGY_BUDGET_CAP_USDC=80.0
BOT_STRATEGY_WALLET_RESERVE_USDC=0.0
BOT_STRATEGY_MIN_BUDGET_USDC=15.0
BOT_STRATEGY_ENTRY_DELAY_SECONDS=0
BOT_STRATEGY_NEW_ORDER_CUTOFF_SECONDS=30
BOT_FORCE_EXIT_BEFORE_END_SECONDS=15

# --- Only if BOT_STRATEGY_MODE=paladin (v4 ladder), not used by paladin_v7 ---
# BOT_PALADIN_PAIR_SUM_MAX=0.97
# BOT_PALADIN_PAIR_SUM_MAX_ON_FORCE=1.0
# BOT_PALADIN_STAGGER_HEDGE_FORCE_SEC=90
